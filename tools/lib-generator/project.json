{
  "name": "lib-generator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/lib-generator/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tools/lib-generator",
        "main": "tools/lib-generator/src/index.ts",
        "tsConfig": "tools/lib-generator/tsconfig.lib.json",
        "assets": [
          "tools/lib-generator/*.md",
          {
            "input": "./tools/lib-generator/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./tools/lib-generator/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./tools/lib-generator",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./tools/lib-generator",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
