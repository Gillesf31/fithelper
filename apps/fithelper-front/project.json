{
  "name": "fithelper-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "fithelper",
  "sourceRoot": "apps/fithelper-front/src",
  "tags": ["scope:fithelper-front", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/fithelper-front",
        "index": "apps/fithelper-front/src/index.html",
        "browser": "apps/fithelper-front/src/main.ts",
        "tsConfig": "apps/fithelper-front/tsconfig.app.json",
        "assets": [
          "apps/fithelper-front/src/favicon.ico",
          "apps/fithelper-front/src/assets"
        ],
        "styles": ["apps/fithelper-front/src/styles.css"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "libs/fithelper-front/environments/util/environment.ts",
              "with": "libs/fithelper-front/environments/util/environment.dev.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "fithelper-front:build:production"
        },
        "development": {
          "buildTarget": "fithelper-front:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "fithelper-front:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/fithelper-front/jest.config.ts",
        "tsConfig": "apps/fithelper-front/tsconfig.spec.json"
      }
    },
    "e2e": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "apps/fithelper-front/cypress.config.ts",
        "testingType": "e2e",
        "devServerTarget": "fithelper-front:serve"
      },
      "configurations": {
        "production": {
          "devServerTarget": "fithelper-front:serve:production"
        }
      }
    }
  }
}
